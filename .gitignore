# ── Model weights ─────────────────────────────────────────────────────────────
*.pth
*.pt
*.ckpt
*.safetensors
*.bin
*.onnx
# Use `/models/*` (anchored, not `models/`) so per-file `!/models/<name>`
# allowlists below can re-include specific weights. Once a parent directory is
# excluded with a trailing slash, git skips it entirely and `!` rules inside
# have no effect. The leading `/` anchors to repo root, so nested vendored
# `models/` directories (e.g. inside vendored CodeFormer) are unaffected.
 /models/*
!/models/*.pth

